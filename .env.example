# QUASAR local/cloud configuration
QUASAR_ARGUS_URL=http://localhost:8000
QUASAR_STATION_ID=default
QUASAR_COLLECTION_INTERVAL_S=30
QUASAR_STALE_AFTER_S=120
QUASAR_RAW_RETENTION_DAYS=30
QUASAR_ANOMALY_COOLDOWN_S=300
QUASAR_CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Authentication / IAM
QUASAR_API_KEY=
IAM_BASE_URL=
QUASAR_IAM_AUDIENCE=ung-quasar

# ARGUS service-to-service auth
ARGUS_API_KEY=

# Optional PostgreSQL; leave blank for local SQLite
DATABASE_URL=

# Optional HERMES notifications
HERMES_BASE_URL=
HERMES_API_KEY=
